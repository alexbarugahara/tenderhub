# ============================================================
# TenderHub Environment Configuration
# ============================================================

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"


# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

NEXT_PUBLIC_APP_URL="http://localhost:3000"

NODE_ENV="development"


# ------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------

AUTH_SECRET="replace-with-a-long-random-secret"

AUTH_URL="http://localhost:3000"


# ------------------------------------------------------------
# FILE UPLOADS
# ------------------------------------------------------------

UPLOAD_DIR="public/uploads"


# ------------------------------------------------------------
# PAYMENTS
# ------------------------------------------------------------

# Current market configuration: United States / USD

PAYMENT_CURRENCY="USD"

# Stripe
STRIPE_SECRET_KEY=""

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

STRIPE_WEBHOOK_SECRET=""


# ------------------------------------------------------------
# OPTIONAL PAYMENT PROVIDERS
# ------------------------------------------------------------

FLUTTERWAVE_SECRET_KEY=""

FLUTTERWAVE_PUBLIC_KEY=""

FLUTTERWAVE_WEBHOOK_SECRET=""


PESAPAL_CONSUMER_KEY=""

PESAPAL_CONSUMER_SECRET=""

PESAPAL_WEBHOOK_SECRET=""


# ------------------------------------------------------------
# EMAIL
# ------------------------------------------------------------

EMAIL_FROM="noreply@example.com"

SMTP_HOST=""

SMTP_PORT="587"

SMTP_USER=""

SMTP_PASSWORD=""


# ------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# ------------------------------------------------------------

# Add provider-specific credentials only when the
# corresponding integration is enabled.

# ACCOUNTING_API_URL=""

# ACCOUNTING_API_KEY=""

# ERP_API_URL=""

# ERP_API_KEY=""


# ------------------------------------------------------------
# DEVELOPMENT / DEMO
# ------------------------------------------------------------

# Set to true only for local development/testing.
# Never enable demo behavior in production.

DEMO_MODE="false"